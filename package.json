{
  "name": "eval-agent",
  "description": "Embedded AI Agent - 面向嵌入式开发的智能 Agent 工具",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "dev": "pnpm --filter @eval-agent/app dev",
    "dev:core": "pnpm --filter @eval-agent/core typecheck",
    "build": "pnpm --filter @eval-agent/app build",
    "lint": "oxlint app/src packages/core/src",
    "typecheck": "pnpm -r typecheck",
    "prepare:server": "node scripts/embed-skills.mjs && bun build --compile packages/core/src/runtime/index.ts --outfile=eval-server/eval-server.exe && node scripts/copy-canvas-runtime.mjs",
    "prepare:serial": "cargo build --release --manifest-path tools/eval-serial/Cargo.toml",
    "prepare:sidecars": "pnpm prepare:server && pnpm prepare:serial",
    "icons": "pnpm --filter @eval-agent/app tauri icon public/eval-logo.svg",
    "test": "bun test packages/core/test",
    "stress:build": "bun scripts/stress-build-pipeline.ts",
    "stress:orchestration": "bun scripts/stress-orchestration.ts",
    "stress:multi-agent": "bun scripts/stress-multi-agent.ts"
  },
  "workspaces": [
    "packages/*",
    "app"
  ],
  "devDependencies": {
    "oxlint": "^1.48.0"
  }
}
