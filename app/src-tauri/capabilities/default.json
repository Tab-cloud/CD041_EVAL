{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Eval 主窗口权限",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "explorer",
          "cmd": "explorer.exe",
          "args": true
        }
      ]
    },
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-read-dir",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:allow-write-file",
    "dialog:default",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-read-text",
    "notification:default",
    "process:allow-restart",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://127.0.0.1:4096/*"
        },
        {
          "url": "https://eval.zailink.space/*"
        }
      ]
    },
    "updater:default"
  ]
}
